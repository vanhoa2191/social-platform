{
  "manifest_version": 3,
  "name": "AutoTool v2 - Social Platform",
  "short_name": "AutoTool",
  "version": "0.13.0",
  "description": "Campaign-centric social workflow control plane with local browser runtime.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Mở AutoTool"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "index.html",
  "optional_host_permissions": [
    "https://*.workers.dev/*",
    "https://*.firebaseapp.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "version_name": "0.13.0-beta"
}
