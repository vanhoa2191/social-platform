rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validHour(value) {
      return value is int && value >= 0 && value <= 23;
    }

    function optionalText(value, maxLength) { return value == null || (value is string && value.size() <= maxLength); }

    function validProfile(profileId) {
      return hasOnly(['id', 'name', 'persona', 'promptVersion', 'config', 'revision', 'updatedAt'])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && optionalText(request.resource.data.get('persona', null), 2000)
        && request.resource.data.promptVersion in ['comment-v1', 'comment-v2']
        && request.resource.data.config is map
        && request.resource.data.config.keys().hasOnly(['strategy', 'notes'])
        && request.resource.data.revision is int
        && request.resource.data.updatedAt is int;
    }

    function validContent(contentId) {
      return hasOnly(['id', 'title', 'kind', 'body', 'tags', 'revision', 'updatedAt'])
        && request.resource.data.id == contentId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.kind in ['prompt', 'template', 'note']
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 10000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 20
        && request.resource.data.revision is int
        && request.resource.data.updatedAt is int;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /browserInstances/{deviceKey} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnly(['id', 'deviceKey', 'name', 'extensionVersion', 'lastSeenAt', 'metadata'])
          && request.resource.data.id == deviceKey
          && request.resource.data.deviceKey == deviceKey
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.extensionVersion is string
          && request.resource.data.metadata.keys().hasOnly(['runtime'])
          && request.resource.data.metadata.runtime in ['extension', 'web-preview'];
      }

      match /aiProfiles/{profileId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validProfile(profileId) && request.resource.data.revision >= 1;
        allow update: if isOwner(userId) && validProfile(profileId)
          && request.resource.data.revision > resource.data.revision;
      }

      match /contentItems/{contentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validContent(contentId) && request.resource.data.revision >= 1;
        allow update: if isOwner(userId) && validContent(contentId)
          && request.resource.data.revision > resource.data.revision;
      }

      match /schedules/{scheduleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (resource == null || request.resource.data.revision > resource.data.revision)
          && hasOnly([
            'id', 'localScheduleId', 'browserInstanceId', 'name', 'enabled',
            'intervalMinutes', 'maxPosts', 'startHour', 'endHour',
            'accountContextKey', 'accountLabel', 'revision',
            'definitionUpdatedAt', 'lastSyncedAt'
          ])
          && request.resource.data.id == scheduleId
          && request.resource.data.localScheduleId == scheduleId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.enabled is bool
          && request.resource.data.intervalMinutes is int
          && request.resource.data.intervalMinutes >= 15
          && request.resource.data.intervalMinutes <= 1440
          && request.resource.data.maxPosts is int
          && request.resource.data.maxPosts >= 1
          && request.resource.data.maxPosts <= 20
          && validHour(request.resource.data.startHour)
          && validHour(request.resource.data.endHour)
          && request.resource.data.revision is int
          && request.resource.data.revision >= 1
          && request.resource.data.definitionUpdatedAt is int;
      }

      match /analyticsEvents/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasOnly(['browserInstanceId', 'localEventId', 'eventType', 'category', 'level', 'payload', 'occurredAt'])
          && request.resource.data.localEventId == eventId
          && request.resource.data.browserInstanceId is string
          && request.resource.data.eventType is string
          && request.resource.data.category in ['SYSTEM', 'QUEUE', 'SCHEDULER', 'REVIEW', 'ADAPTER']
          && request.resource.data.level in ['INFO', 'WARN', 'ERROR']
          && request.resource.data.payload.keys().hasOnly(['schemaVersion'])
          && request.resource.data.payload.schemaVersion == 1;
      }

      match /{unknownCollection}/{documentId} {
        allow read, write: if false;
      }
    }
  }
}
