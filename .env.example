# Firebase Web configuration.
# These values identify the Firebase project; Firestore Security Rules protect user data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Exact trusted Cloudflare Worker origin used when Firebase ID-token auth is enabled.
# Example: https://autotool-ai-gateway.example.workers.dev
VITE_AI_GATEWAY_ORIGIN=

# Keep false for controlled/stable builds. Client-side hiding is not a substitute for
# Firebase/Identity Platform abuse controls; provision approved users deliberately.
VITE_FIREBASE_ALLOW_REGISTRATION=false

# Optional Firebase Web config values.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Local emulator mode (optional).
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
