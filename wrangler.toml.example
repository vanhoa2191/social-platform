name = "autotool-ai-gateway"
main = "dist-gateway/worker.js"
compatibility_date = "2026-10-01"

[vars]
GATEWAY_AUTH_MODE = "firebase"
FIREBASE_PROJECT_ID = "your-firebase-project-id"
ALLOWED_ORIGINS = "http://localhost:5173"
AI_PROVIDER = "mock"
AI_MODEL = "mock-v1"
AI_INPUT_USD_PER_M = "0"
AI_OUTPUT_USD_PER_M = "0"
RATE_LIMIT_PER_MINUTE = "30"
PROVIDER_TIMEOUT_MS = "25000"
MAX_BODY_BYTES = "16384"

# Configure secrets with:
# wrangler secret put GATEWAY_TOKEN
# wrangler secret put AI_API_KEY
#
# Production: Firebase ID token. GATEWAY_TOKEN is a dev fallback, not recommended for production.
#
# Provider options:
# mock | openai | deepseek | anthropic | gemini
#
# Optional:
# AI_BASE_URL = "https://..."

# Per-UID Durable Object quota. Required whenever AI_PROVIDER is not "mock".
[[durable_objects.bindings]]
name = "RATE_LIMITER"
class_name = "UserRateLimiter"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["UserRateLimiter"]

# ALLOWED_ORIGINS must include the exact installed Chrome extension origin, e.g.
# ALLOWED_ORIGINS = "chrome-extension://abcdefghijklmnopabcdefghijklmnop"
# Do not use "*" or arbitrary web origins.
